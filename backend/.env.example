# Copier ce fichier en ".env" (même dossier) puis adapter. Ne JAMAIS publier .env.
PORT=3001
# Base PostgreSQL lancée par Docker (port 5433 sur votre PC)
DATABASE_URL=postgresql://edugestion:edugestion_dev_password@127.0.0.1:5433/edugestion
# Chaîne aléatoire d'au moins 32 caractères (voir guide pour en générer une)
JWT_SECRET=CHANGEZ_MOI_chaine_aleatoire_de_plus_de_32_caracteres_0123456789
# Premier compte Super Admin (créé automatiquement au premier démarrage)
SUPERADMIN_EMAIL=superadmin@edugestion.test
SUPERADMIN_PASSWORD=SuperAdmin-Dev-2026
# Développement uniquement : crée École A et École B avec leurs comptes de démonstration
DEV_SEED=true
DEV_PASSWORD_A=EcoleA-Dev-2026
DEV_PASSWORD_B=EcoleB-Dev-2026
