# ===== Docker (docker-compose.yml) : copier ce fichier en ".env" à la racine du projet =====
# ATTENTION : si un mot de passe contient le caractère #, entourez-le de guillemets "…"
POSTGRES_PASSWORD=edugestion_local_password
# Chaîne secrète d'au moins 32 caractères (voir guide : commande pour en générer une)
JWT_SECRET=CHANGEZ_MOI_chaine_aleatoire_de_plus_de_32_caracteres_0123456789
SUPERADMIN_EMAIL=superadmin@edugestion.test
SUPERADMIN_PASSWORD=SuperAdmin-Dev-2026
# Développement local : true = crée École A et École B avec comptes de démonstration. Mettre false en production.
DEV_SEED=true
DEV_PASSWORD_A=EcoleA-Dev-2026
DEV_PASSWORD_B=EcoleB-Dev-2026
APP_PORT=3001
